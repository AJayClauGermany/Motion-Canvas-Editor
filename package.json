{
  "name": "motion-canvas-editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Manim-style animation editor on Canvas Commons, Civet and Solid 2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:e2e": "node tools/e2e.cjs",
    "test:ui": "node tools/ui-smoke.cjs",
    "mcp": "bun src/mcp/main.ts",
    "mcp:http": "bun src/mcp/main.ts --http",
    "shell:dev": "bun run build && electrobun dev",
    "shell:run": "electrobun run --env=dev",
    "shell:build": "bun run build && electrobun build --env=stable",
    "shell:typecheck": "electrobun prepare && tsc --noEmit -p shell/tsconfig.json"
  },
  "dependencies": {
    "@canvas-commons/2d": "0.4.0",
    "@canvas-commons/core": "0.4.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@danielx/civet": "0.11.17",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@solidjs/web": "2.0.3",
    "acorn": "^8.19.0",
    "chroma-js": "^3.3.0",
    "codemirror": "^6.0.2",
    "gifenc": "1.0.3",
    "magic-string": "^1.4.5",
    "mathjax-full": "3.2.2",
    "mediabunny": "1.65.2",
    "solid-js": "2.0.3",
    "sucrase": "^3.35.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/bun": "^1.4.5",
    "electrobun": "2.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
