from manim import *

class FollowingGraphCamera extends Scene
  construct()
    @camera.frame.save_state()

    # create the axes and the curve
    ax := Axes x_range: [-1, 10], y_range: [-1, 10]
    graph := ax.plot ((x) => np.sin(x)), color: BLUE, x_range: [0, 3 * PI]

    # create dots based on the graph
    moving_dot := Dot ax.i2gp(graph.t_min, graph), color: ORANGE
    dot_1 := Dot ax.i2gp(graph.t_min, graph)
    dot_2 := Dot ax.i2gp(graph.t_max, graph)

    @add ax, graph, dot_1, dot_2, moving_dot
    @play @camera.frame.animate.scale(0.5).move_to(moving_dot)

    update_curve := (mob) =>
      mob.move_to moving_dot.get_center()

    @camera.frame.add_updater update_curve
    @play MoveAlongPath(moving_dot, graph, rate_func: linear)
    @camera.frame.remove_updater update_curve

    @play Restore @camera.frame
