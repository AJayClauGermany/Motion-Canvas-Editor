from manim import *

class PointMovingOnShapes extends Scene
  construct()
    circle := Circle radius: 1, color: BLUE
    dot := Dot()
    dot2 := dot.copy().shift(RIGHT)
    @add dot

    line := Line [3, 0, 0], [5, 0, 0]
    @add line

    @play GrowFromCenter circle
    @play Transform dot, dot2
    @play MoveAlongPath(dot, circle), run_time: 2, rate_func: linear
    @play Rotating(dot, about_point: [2, 0, 0]), run_time: 1.5
    @wait()
