{
  // `electrobun/*` resolves into the SDK that Hutch projects into .hutch/devkit
  // (generated by `electrobun prepare`, `build` or `dev`; gitignored).
  "extends": "../.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    // The devkit config sets baseUrl, which TypeScript 7 rejects. Its paths are
    // resolved relative to the devkit directory without it.
    "baseUrl": null,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "../electrobun.config.ts"]
}
